{
  "name": "nike-ai-tools-directory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "泥壳AI工具站全栈应用，Node.js、SQLite 本地开发与 MariaDB 生产运行。",
  "scripts": {
    "start": "node --env-file-if-exists=.env --no-warnings server.mjs",
    "dev": "node --env-file-if-exists=.env --no-warnings --watch server.mjs",
    "test": "node --no-warnings --test --test-concurrency=1 tests/*.test.mjs",
    "seed:export": "node scripts/export-seed.mjs",
    "logos:sync": "node --no-warnings scripts/sync-tool-logos.mjs",
    "logos:verify": "node --no-warnings scripts/sync-tool-logos.mjs --verify",
    "catalog:import": "node --env-file-if-exists=.env --no-warnings scripts/import-tool-catalog.mjs",
    "catalog:import:official": "node --env-file-if-exists=.env --no-warnings scripts/import-official-catalog.mjs",
    "newsletter:send": "node --env-file-if-exists=.env --no-warnings scripts/send-weekly-digest.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "mysql2": "3.24.4"
  }
}
