# 本地默认只监听 127.0.0.1:4173
HOST=127.0.0.1
PORT=4173
NODE_ENV=development
# 生产设置为站点规范域名；本地留空以使用当前本地地址
PUBLIC_BASE_URL=

# 相对路径会按项目根目录解析
NIKE_DB_PATH=./data/nike-ai.db
# 本地默认 SQLite；生产 MariaDB 时设置为 mariadb，并同时配置下面的连接变量
NIKAI_DB_ENGINE=sqlite
NIKAI_DB_NAME=nikai_ai
NIKAI_DB_USER=
NIKAI_DB_PASSWORD=
NIKAI_DB_SOCKET=/var/lib/mysql/mysql.sock

# 生产环境必须设置为高强度随机值；留空时管理接口关闭
NIKE_ADMIN_TOKEN=
NIKE_ANALYTICS_SALT=
# 图片平台 API Key 加密主密钥：须为 64 个十六进制字符（32 字节随机值）；勿提交真实值
NIKE_IMAGE_CONFIG_KEY=
NIKE_ENABLE_TOKEN_ADMIN=false
NIKE_AUTO_SEED=true

# 多个来源用英文逗号分隔。同源部署不需要额外配置。
NIKE_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
NIKE_TRUST_PROXY=false

# 自动采编：配置 OpenAI API Key 并设为 true 后启用
OPENAI_API_KEY=
NIKE_AUTO_NEWS=false
# 图片消除：独立 CPU Python 环境及经过校验的 LaMa 模型绝对路径
NIKE_ERASE_PYTHON=
NIKE_ERASE_MODEL=
NIKE_NEWS_INTERVAL_MINUTES=360
NIKE_NEWS_AI_MODEL=gpt-5.5
NIKE_NEWS_BASE_URL=https://lucen.cc
NIKE_NEWS_API_PATH=/v1/responses
NIKE_NEWS_REASONING_EFFORT=xhigh
NIKE_NEWS_DISABLE_RESPONSE_STORAGE=true
NIKE_NEWS_FEEDS=https://openai.com/news/rss.xml,https://news.microsoft.com/source/topics/ai/feed/,https://blog.google/technology/ai/rss/

# 周报邮件（Resend）；发件地址回退 FEEDBACK_EMAIL_FROM / AUTH_EMAIL_FROM
RESEND_API_KEY=
WEEKLY_EMAIL_FROM=

# 图片抠图 / 3 倍增强：Python 不填时沿用 NIKE_ERASE_PYTHON
NIKE_IMAGE_PYTHON=
NIKE_IMAGE_BACKGROUND_MODEL=
NIKE_IMAGE_ENHANCE_MODEL=

# 已验证域名的验证码发件地址
AUTH_EMAIL_FROM=

# Production enables the anonymous Douyin prototype; set 0 to disable online mode.
# NIKE_DOUYIN_PUBLIC_ENABLED=0

# Feedback notification recipient; sender falls back to verified AUTH_EMAIL_FROM
FEEDBACK_EMAIL_TO=
FEEDBACK_EMAIL_FROM=
