[Unit]
Description=NeStdutio verified custom domain certificates
After=network-online.target nginx.service nikai-ai.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nikai-nestdutio-domains.env
ExecStart=/usr/bin/flock -n /run/nikai-nestdutio-domains.lock /usr/local/bin/node /usr/local/libexec/nikai-nestdutio-domains/domain-worker.mjs
TimeoutStartSec=600
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/nginx/nestdutio-domains.d /etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt /var/lib/nikai-acme

