{
  "schemaVersion": 1,
  "name": "习惯打卡工具",
  "entry": "index.html",
  "files": [
    {
      "path": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>习惯打卡工具</title>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  :root {\n    --bg: #f4f6fb;\n    --card: #ffffff;\n    --text: #1f2937;\n    --muted: #6b7280;\n    --primary: #4f46e5;\n    --primary-dark: #4338ca;\n    --done: #10b981;\n    --danger: #ef4444;\n    --border: #e5e7eb;\n  }\n  body {\n    font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n    background: linear-gradient(180deg, #eef2ff 0%, var(--bg) 40%);\n    color: var(--text);\n    min-height: 100vh;\n    padding: 24px 16px 48px;\n    line-height: 1.5;\n  }\n  .app { max-width: 640px; margin: 0 auto; }\n  header { margin-bottom: 20px; }\n  h1 { font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; }\n  .subtitle { color: var(--muted); font-size: 0.9rem; margin-top: 4px; }\n  .note {\n    background: #fffbeb;\n    border: 1px solid #fde68a;\n    color: #92400e;\n    border-radius: 12px;\n    padding: 12px 14px;\n    font-size: 0.85rem;\n    margin-top: 14px;\n  }\n  .panel {\n    background: var(--card);\n    border-radius: 16px;\n    padding: 16px;\n    box-shadow: 0 4px 18px rgba(79, 70, 229, 0.08), 0 1px 3px rgba(0,0,0,0.04);\n    border: 1px solid rgba(229, 231, 235, 0.7);\n  }\n  .add-form { display: flex; gap: 10px; }\n  #habit-name {\n    flex: 1;\n    min-width: 0;\n    padding: 12px 14px;\n    border-radius: 10px;\n    border: 1.5px solid var(--border);\n    font-size: 1rem;\n    background: #fbfcfe;\n    color: var(--text);\n    transition: border-color .15s, box-shadow .15s;\n  }\n  #habit-name:focus {\n    outline: none;\n    border-color: var(--primary);\n    box-shadow: 0 0 0 3px rgba(79,70,229,0.15);\n    background: #fff;\n  }\n  #add-habit {\n    flex-shrink: 0;\n    padding: 12px 20px;\n    border: none;\n    border-radius: 10px;\n    background: var(--primary);\n    color: #fff;\n    font-size: 1rem;\n    font-weight: 600;\n    cursor: pointer;\n    transition: background .15s, transform .05s;\n  }\n  #add-habit:hover { background: var(--primary-dark); }\n  #add-habit:active { transform: scale(0.97); }\n  #add-habit:focus-visible { outline: 3px solid rgba(79,70,229,0.4); outline-offset: 2px; }\n  .error {\n    color: var(--danger);\n    font-size: 0.85rem;\n    min-height: 1.2em;\n    margin-top: 8px;\n    opacity: 0;\n    transition: opacity .15s;\n  }\n  .error.show { opacity: 1; }\n  .list-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin: 22px 0 10px;\n    font-size: 0.85rem;\n    color: var(--muted);\n  }\n  #habit-list { display: flex; flex-direction: column; gap: 10px; }\n  .habit-row {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    background: var(--card);\n    border: 1px solid var(--border);\n    border-radius: 14px;\n    padding: 14px 14px;\n    box-shadow: 0 1px 2px rgba(0,0,0,0.03);\n    transition: border-color .15s, background .15s;\n  }\n  .habit-row.done { border-color: rgba(16,185,129,0.45); background: #f0fdfa; }\n  .check-in {\n    flex-shrink: 0;\n    width: 44px;\n    height: 44px;\n    border-radius: 50%;\n    border: 2px solid var(--border);\n    background: #fff;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 1.1rem;\n    transition: background .15s, border-color .15s, transform .05s;\n    color: #fff;\n    position: relative;\n  }\n  .check-in::after {\n    content: \"\";\n    width: 10px; height: 10px;\n    border-radius: 50%;\n    background: var(--done);\n    opacity: 0;\n    transform: scale(0.4);\n    transition: opacity .15s, transform .15s;\n  }\n  .habit-row.done .check-in {\n    background: var(--done);\n    border-color: var(--done);\n  }\n  .habit-row.done .check-in::after {\n    content: \"✓\";\n    width: auto; height: auto;\n    background: transparent;\n    color: #fff;\n    font-size: 1.1rem;\n    font-weight: 700;\n    opacity: 1;\n    transform: none;\n  }\n  .check-in:hover { border-color: var(--primary); }\n  .check-in:active { transform: scale(0.92); }\n  .habit-main { flex: 1; min-width: 0; }\n  .habit-name {\n    font-size: 1rem;\n    font-weight: 500;\n    word-break: break-word;\n    transition: color .15s;\n  }\n  .habit-row.done .habit-name { color: var(--muted); text-decoration: line-through; }\n  .status {\n    font-size: 0.78rem;\n    color: var(--muted);\n    margin-top: 2px;\n  }\n  .habit-row.done .status { color: var(--done); font-weight: 600; }\n  .delete-habit {\n    flex-shrink: 0;\n    width: 36px; height: 36px;\n    border-radius: 9px;\n    border: 1px solid transparent;\n    background: transparent;\n    color: var(--muted);\n    font-size: 1.1rem;\n    cursor: pointer;\n    display: flex; align-items: center; justify-content: center;\n    transition: background .15s, color .15s, border-color .15s;\n  }\n  .delete-habit:hover { background: #fef2f2; color: var(--danger); border-color: #fecaca; }\n  .delete-habit:active { transform: scale(0.92); }\n  .empty {\n    text-align: center;\n    color: var(--muted);\n    font-size: 0.9rem;\n    padding: 32px 12px;\n    border: 1.5px dashed var(--border);\n    border-radius: 14px;\n    background: rgba(255,255,255,0.5);\n  }\n  footer {\n    text-align: center;\n    color: var(--muted);\n    font-size: 0.78rem;\n    margin-top: 26px;\n    padding-bottom: 8px;\n  }\n  @media (max-width: 420px) {\n    body { padding: 18px 12px 40px; }\n    h1 { font-size: 1.35rem; }\n    #add-habit { padding: 12px 16px; }\n    .habit-row { padding: 12px; gap: 10px; }\n  }\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <header>\n    <h1>习惯打卡</h1>\n    <p class=\"subtitle\">记录每一个坚持的小习惯</p>\n    <div class=\"note\">数据只保存在此浏览器的本地存储中，不会云同步，也不会发送到任何服务器。清除浏览器数据后记录将丢失。</div>\n  </header>\n\n  <main>\n    <section class=\"panel\" aria-label=\"添加习惯\">\n      <div class=\"add-form\">\n        <input id=\"habit-name\" data-nest-check=\"habit-name\" type=\"text\" maxlength=\"60\" placeholder=\"例如：喝水、读书、运动\" aria-label=\"习惯名称\" autocomplete=\"off\">\n        <button id=\"add-habit\" data-nest-check=\"add-habit\" type=\"button\">添加</button>\n      </div>\n      <div class=\"error\" id=\"error-msg\" role=\"alert\" aria-live=\"polite\"></div>\n    </section>\n\n    <div class=\"list-header\">\n      <span>我的习惯</span>\n      <span id=\"summary\"></span>\n    </div>\n\n    <div id=\"habit-list\" aria-live=\"polite\"></div>\n  </main>\n\n  <footer>本地保存 · 刷新后依然保留</footer>\n</div>\n\n<script>\n(function () {\n  'use strict';\n\n  var STORAGE_KEY = 'habit-tracker-state-v1';\n\n  var nameInput = document.getElementById('habit-name');\n  var addBtn = document.getElementById('add-habit');\n  var listEl = document.getElementById('habit-list');\n  var errorEl = document.getElementById('error-msg');\n  var summaryEl = document.getElementById('summary');\n\n  var habits = [];\n\n  function load() {\n    try {\n      var raw = localStorage.getItem(STORAGE_KEY);\n      if (!raw) { habits = []; return; }\n      var parsed = JSON.parse(raw);\n      if (Array.isArray(parsed)) {\n        habits = parsed.filter(function (h) {\n          return h && typeof h.id === 'string' && typeof h.name === 'string';\n        }).map(function (h) {\n          return {\n            id: h.id,\n            name: h.name,\n            done: !!h.done,\n            createdAt: typeof h.createdAt === 'number' ? h.createdAt : Date.now()\n          };\n        });\n      } else {\n        habits = [];\n      }\n    } catch (e) {\n      habits = [];\n    }\n  }\n\n  function save() {\n    try {\n      localStorage.setItem(STORAGE_KEY, JSON.stringify(habits));\n    } catch (e) {\n      // 存储空间不足或被禁用时静默失败，界面仍可继续使用\n    }\n  }\n\n  function showError(msg) {\n    errorEl.textContent = msg;\n    errorEl.classList.toggle('show', !!msg);\n  }\n\n  function makeId() {\n    return 'h_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 8);\n  }\n\n  function updateSummary() {\n    if (habits.length === 0) { summaryEl.textContent = ''; return; }\n    var doneCount = habits.reduce(function (n, h) { return n + (h.done ? 1 : 0); }, 0);\n    summaryEl.textContent = doneCount + ' / ' + habits.length + ' 已完成';\n  }\n\n  function render() {\n    listEl.innerHTML = '';\n\n    if (habits.length === 0) {\n      var empty = document.createElement('div');\n      empty.className = 'empty';\n      empty.textContent = '还没有习惯，先在上方添加一个吧。';\n      listEl.appendChild(empty);\n      updateSummary();\n      return;\n    }\n\n    habits.forEach(function (habit) {\n      var row = document.createElement('div');\n      row.className = 'habit-row' + (habit.done ? ' done' : '');\n      row.setAttribute('data-nest-check', 'habit');\n      row.setAttribute('data-id', habit.id);\n\n      var checkBtn = document.createElement('button');\n      checkBtn.type = 'button';\n      checkBtn.className = 'check-in';\n      checkBtn.setAttribute('data-nest-check', 'check-in');\n      checkBtn.setAttribute('aria-pressed', habit.done ? 'true' : 'false');\n      checkBtn.setAttribute('aria-label', (habit.done ? '取消完成：' : '标记完成：') + habit.name);\n      checkBtn.addEventListener('click', function () {\n        toggleHabit(habit.id);\n      });\n\n      var main = document.createElement('div');\n      main.className = 'habit-main';\n\n      var nameEl = document.createElement('div');\n      nameEl.className = 'habit-name';\n      nameEl.textContent = habit.name;\n\n      var statusEl = document.createElement('div');\n      statusEl.className = 'status';\n      statusEl.textContent = habit.done ? '已完成' : '未完成';\n\n      main.appendChild(nameEl);\n      main.appendChild(statusEl);\n\n      var delBtn = document.createElement('button');\n      delBtn.type = 'button';\n      delBtn.className = 'delete-habit';\n      delBtn.setAttribute('data-nest-check', 'delete-habit');\n      delBtn.setAttribute('aria-label', '删除习惯：' + habit.name);\n      delBtn.innerHTML = '✕';\n      delBtn.addEventListener('click', function () {\n        deleteHabit(habit.id);\n      });\n\n      row.appendChild(checkBtn);\n      row.appendChild(main);\n      row.appendChild(delBtn);\n\n      listEl.appendChild(row);\n    });\n\n    updateSummary();\n  }\n\n  function addHabit() {\n    var name = nameInput.value.trim();\n    if (!name) {\n      showError('请输入习惯名称，不能为空。');\n      nameInput.focus();\n      return;\n    }\n    showError('');\n    habits.push({\n      id: makeId(),\n      name: name,\n      done: false,\n      createdAt: Date.now()\n    });\n    nameInput.value = '';\n    save();\n    render();\n    nameInput.focus();\n  }\n\n  function toggleHabit(id) {\n    for (var i = 0; i < habits.length; i++) {\n      if (habits[i].id === id) {\n        habits[i].done = !habits[i].done;\n        break;\n      }\n    }\n    save();\n    render();\n  }\n\n  function deleteHabit(id) {\n    habits = habits.filter(function (h) { return h.id !== id; });\n    save();\n    render();\n  }\n\n  addBtn.addEventListener('click', addHabit);\n\n  nameInput.addEventListener('keydown', function (e) {\n    if (e.key === 'Enter') {\n      e.preventDefault();\n      addHabit();\n    }\n  });\n\n  nameInput.addEventListener('input', function () {\n    if (errorEl.classList.contains('show') && nameInput.value.trim()) {\n      showError('');\n    }\n  });\n\n  load();\n  render();\n})();\n</script>\n</body>\n</html>"
    }
  ],
  "capabilities": [
    "localStorage"
  ],
  "acceptance": [
    {
      "kind": "fill",
      "target": "#habit-name",
      "input": "喝水"
    },
    {
      "kind": "clickText",
      "target": "#add-habit",
      "output": "#habit-list",
      "value": "喝水"
    },
    {
      "kind": "fill",
      "target": "#habit-name",
      "input": "读书"
    },
    {
      "kind": "clickText",
      "target": "#add-habit",
      "output": "#habit-list",
      "value": "读书"
    },
    {
      "kind": "clickText",
      "target": "#habit-list .habit-row:first-child .check-in",
      "output": "#habit-list .habit-row:first-child",
      "value": "已完成"
    },
    {
      "kind": "fill",
      "target": "#habit-name",
      "input": "x"
    },
    {
      "kind": "clickText",
      "target": "#add-habit",
      "output": "#habit-list",
      "value": "x"
    },
    {
      "kind": "clickText",
      "target": "#habit-list .habit-row:last-child .delete-habit",
      "output": "#habit-list",
      "value": "读书"
    }
  ]
}